# Moonshot / Kimi（OpenAI 兼容）— 开放编码、主轴编码、选择性编码
MOONSHOT_API_KEY=your_moonshot_api_key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.5
# kimi-k2.5 等模型可能仅允许 temperature=1；换其他模型时可改为 0.3 等
MOONSHOT_TEMPERATURE=1
# 主轴编码输出 token 上限（JSON 长时易截断，默认 32000）
# MOONSHOT_AXIAL_MAX_OUTPUT_TOKENS=32000

# OpenRouter — 理论框架图（AI 直接生成图片）
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Clash 等本地代理（Node/Next 服务端不会自动走系统代理，需显式配置；与密钥同级写在 .env 即可）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# 图片生成模型，默认 google/gemini-3-pro-image-preview
# OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image-preview
# 图片尺寸，可选 1K / 2K / 4K，默认 2K
# OPENROUTER_IMAGE_SIZE=2K
# 图片比例，默认 4:3（横版学术图）
# OPENROUTER_IMAGE_ASPECT_RATIO=4:3
# 可选：OpenRouter 官方建议在请求头中附带（本仓库代码已有默认值，一般不必改）
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=qualitative-coding-assistant
